# AWS 환경변수 설정 파일
# 이 파일을 .env.aws로 복사하고 실제 값으로 수정하세요
# cp .env.aws.example .env.aws

# ===== AWS 계정 정보 =====
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-northeast-2

# ===== AWS S3 설정 (MinIO 대체) =====
# S3 버킷 접근을 위한 IAM 사용자 credentials
AWS_S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=database-api-files

# MinIO 호환 설정 (S3 사용 시 필요)
MINIO_ROOT_USER=${AWS_S3_ACCESS_KEY_ID}
MINIO_ROOT_PASSWORD=${AWS_S3_SECRET_ACCESS_KEY}
MINIO_ENDPOINT=s3.ap-northeast-2.amazonaws.com
MINIO_BUCKET_NAME=${AWS_S3_BUCKET_NAME}

# ===== PostgreSQL (RDS) 설정 =====
POSTGRES_USER=dbadmin
POSTGRES_PASSWORD=YourStrongPasswordHere!
POSTGRES_DB=postgres
POSTGRES_HOST=database-api-db.cluster-xxxxx.ap-northeast-2.rds.amazonaws.com
POSTGRES_PORT=5432

# ===== OpenSearch 설정 (외부/온프레미스) =====
# 기존 Docker Compose의 OpenSearch를 사용하는 경우
# 외부에서 접근 가능한 IP 또는 도메인을 입력하세요
# 예시:
# - EC2에서 Docker 실행: ec2-xx-xx-xx-xx.compute.amazonaws.com
# - 고정 IP: 123.456.789.012
# - 도메인: opensearch.yourcompany.com
# - 로컬 테스트 (주의: 프로덕션에서는 사용 불가): host.docker.internal
OPENSEARCH_HOST=your-external-opensearch-ip-or-domain
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_INITIAL_ADMIN_PASSWORD=YourOpenSearchPassword!

# ===== JWT 설정 =====
# JWT 시크릿 키 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== OpenAI 설정 =====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 애플리케이션 설정 =====
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# ===== PgAdmin 설정 (선택사항) =====
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=YourPgAdminPassword!

# ===== ECS/Fargate 설정 =====
ECS_CLUSTER_NAME=database-api-cluster
ECS_SERVICE_NAME=database-api-service
ECS_TASK_FAMILY=database-fastapi-app

# ===== Application Load Balancer 설정 (선택사항) =====
ALB_NAME=database-api-alb
TARGET_GROUP_NAME=database-api-tg
HEALTH_CHECK_PATH=/health

# ===== Route53 설정 (선택사항) =====
DOMAIN_NAME=api.yourdomain.com
HOSTED_ZONE_ID=Z1234567890ABC

# ===== CloudWatch 설정 =====
LOG_GROUP_NAME=/ecs/database-fastapi-app
LOG_RETENTION_DAYS=7

# ===== Auto Scaling 설정 (선택사항) =====
MIN_TASKS=1
MAX_TASKS=10
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=80