{
  "info": {
    "name": "Customer API Collection - New Endpoints",
    "description": "거래처 목록, 검색, 상세 정보 조회 API 테스트 컬렉션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8010",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "description": "JWT 액세스 토큰 - 로그인 후 자동 설정됨"
    }
  ],
  "item": [
    {
      "name": "인증",
      "item": [
        {
          "name": "로그인 (토큰 발급)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.access_token);",
                  "    console.log(\"Access token saved successfully\");",
                  "    console.log(\"Token:\", jsonData.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin",
                  "description": "사용자명 (이메일)",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "admin123",
                  "description": "비밀번호",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token"
              ]
            },
            "description": "로그인하여 JWT 액세스 토큰을 발급받습니다. 토큰은 자동으로 변수에 저장됩니다."
          }
        }
      ]
    },
    {
      "name": "거래처 조회 API",
      "item": [
        {
          "name": "거래처 목록 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var customers = pm.response.json();",
                  "    console.log(\"거래처 목록 조회 성공:\", customers.length + \"개\");",
                  "    ",
                  "    // 첫 번째 거래처 ID를 변수로 저장 (다른 테스트에서 사용)",
                  "    if (customers.length > 0) {",
                  "        pm.collectionVariables.set(\"test_customer_id\", customers[0].customer_id);",
                  "        pm.collectionVariables.set(\"test_customer_name\", customers[0].customer_name);",
                  "        console.log(\"테스트용 거래처 ID 저장:\", customers[0].customer_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers?skip=0&limit=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0",
                  "description": "건너뛸 항목 수"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "조회할 최대 항목 수"
                }
              ]
            },
            "description": "모든 거래처의 기본 정보 목록을 조회합니다.\n\n**Query Parameters:**\n- skip: 건너뛸 항목 수 (페이지네이션)\n- limit: 조회할 최대 항목 수 (기본값: 100)\n\n**Response:**\n- 거래처 정보 배열 (ID, 이름, 등급, 주소, 담당자, 연락처 등)"
          }
        },
        {
          "name": "거래처명으로 검색",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has required fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('search_term');",
                  "    pm.expect(jsonData).to.have.property('count');",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var result = pm.response.json();",
                  "    console.log(\"검색어:\", result.search_term);",
                  "    console.log(\"검색 결과:\", result.count + \"개\");",
                  "    ",
                  "    if (result.results.length > 0) {",
                  "        console.log(\"검색된 거래처:\");",
                  "        result.results.forEach(function(customer) {",
                  "            console.log(\"  - \" + customer.customer_name + \" (ID: \" + customer.customer_id + \")\");",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/search?name=병원",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "병원",
                  "description": "검색할 거래처명 (부분 일치)"
                }
              ]
            },
            "description": "거래처명으로 거래처 정보와 ID를 검색합니다.\n\n**Query Parameters:**\n- name: 검색할 거래처명 (부분 일치 검색)\n\n**Response:**\n- search_term: 검색어\n- count: 검색 결과 수\n- results: 매칭된 거래처 목록"
          }
        },
        {
          "name": "거래처 상세 정보 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has customer details\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('customer_id');",
                  "    pm.expect(jsonData).to.have.property('customer_name');",
                  "    pm.expect(jsonData).to.have.property('customer_grade');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var customer = pm.response.json();",
                  "    console.log(\"거래처 상세 정보:\");",
                  "    console.log(\"  ID:\", customer.customer_id);",
                  "    console.log(\"  이름:\", customer.customer_name);",
                  "    console.log(\"  등급:\", customer.customer_grade);",
                  "    console.log(\"  주소:\", customer.address);",
                  "    console.log(\"  담당자:\", customer.doctor_name);",
                  "    console.log(\"  연락처:\", customer.contact_number);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer",
                "1"
              ]
            },
            "description": "특정 거래처의 모든 상세 정보를 조회합니다.\n\n**Path Parameters:**\n- customer_id: 거래처 ID\n\n**Response:**\n- 거래처 전체 정보 (ID, 이름, 등급, 주소, 담당자, 연락처, 메모, 생성일시)"
          }
        },
        {
          "name": "거래처 상세 정보 조회 (변수 사용)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var customer = pm.response.json();",
                  "    console.log(\"변수로 저장된 거래처 조회 성공:\");",
                  "    console.log(\"  이름:\", customer.customer_name);",
                  "} else if (pm.response.code === 404) {",
                  "    console.log(\"거래처를 찾을 수 없습니다. 먼저 '거래처 목록 조회'를 실행하세요.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/{{test_customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer",
                "{{test_customer_id}}"
              ]
            },
            "description": "이전 테스트에서 저장된 거래처 ID로 상세 정보를 조회합니다.\n\n**Note:** '거래처 목록 조회'를 먼저 실행해야 test_customer_id 변수가 설정됩니다."
          }
        }
      ]
    },
    {
      "name": "페이지네이션 테스트",
      "item": [
        {
          "name": "첫 페이지 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers?skip=0&limit=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "처음 5개 거래처 조회"
          }
        },
        {
          "name": "두 번째 페이지 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers?skip=5&limit=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "skip",
                  "value": "5"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "6-10번째 거래처 조회"
          }
        }
      ]
    },
    {
      "name": "검색 테스트 시나리오",
      "item": [
        {
          "name": "부분 일치 검색 - '서울'",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/search?name=서울",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "서울"
                }
              ]
            },
            "description": "'서울'이 포함된 모든 거래처 검색"
          }
        },
        {
          "name": "부분 일치 검색 - '의원'",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/search?name=의원",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "의원"
                }
              ]
            },
            "description": "'의원'이 포함된 모든 거래처 검색"
          }
        },
        {
          "name": "결과 없는 검색",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/search?name=존재하지않는거래처",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer",
                "search"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "존재하지않는거래처"
                }
              ]
            },
            "description": "검색 결과가 없는 경우 테스트"
          }
        }
      ]
    },
    {
      "name": "에러 케이스 테스트",
      "item": [
        {
          "name": "존재하지 않는 거래처 조회",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error message is present\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('detail');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customer/99999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer",
                "99999"
              ]
            },
            "description": "존재하지 않는 거래처 ID로 조회 시 404 에러 테스트"
          }
        },
        {
          "name": "인증 없이 접근",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// 이 요청에서만 토큰을 제거",
                  "pm.request.removeHeader('Authorization');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/customers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customers"
              ]
            },
            "description": "인증 토큰 없이 API 접근 시 401 에러 테스트"
          }
        }
      ]
    }
  ]
}